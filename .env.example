# PostgreSQL
POSTGRES_USER=eventsocial
POSTGRES_PASSWORD=eventsocial_secret
POSTGRES_DB=eventsocial
DATABASE_URL=postgresql+asyncpg://eventsocial:eventsocial_secret@db:5432/eventsocial

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CONTENT_PER_MINUTE=30

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
